  playMelody(melody4, notes4, wholenote1);
  playMelody(melody5, notes5, wholenote2);
  playMelody(melody6, notes6, wholenote3);
  playMelody(melody7, notes7, wholenote1);
  playMelody(melody8, notes8, wholenote);
}

